{
  "name": "dandiyaa",
  "version": "1.0.0",
  "description": "Official Event & Registration Website for **Jaynagar Milan Utsav 2026** (Dandiya & Jhijhiya Special Night), organised with pride by **Motion Arts Academy**.",
  "main": "app.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build-static.js",
