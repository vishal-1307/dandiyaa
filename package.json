  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "dotenv": "^18.0.7",
    "razorpay": "^2.9.8"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "pg": "^8.23.1"
